# MongoDB connection string
MONGODB_URI=mongodb://127.0.0.1:27017/sfs_gallery

# Secret used to sign admin session JWTs (use a long random string, 32+ chars)
JWT_SECRET=change-me-to-a-long-random-secret

# First admin account, created by: npm run seed-admin
ADMIN_EMAIL=admin@sfsgallery.com
ADMIN_PASSWORD=ChangeMe123!

# Where uploaded media is written (relative to project root) and the public URL base
# it is served from (Next in dev, NGINX in production).
UPLOAD_DIR=public/uploads
NEXT_PUBLIC_UPLOAD_BASE=/uploads
